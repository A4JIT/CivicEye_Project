# ========================================================
# CivicEye AI Backend Environment Variables
# ========================================================

# Server Port (Render and Railway set this automatically via $PORT)
PORT=8080

# Option 1: Direct Cloud Database URL (Supabase, Neon, Render Postgres, Railway)
# e.g., postgresql://username:password@ep-xyz.aws.neon.tech/civiceye?sslmode=require
DATABASE_URL=

# Option 2: Individual DB credentials (if not using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civiceye
DB_USER=postgres
DB_PASSWORD=postgres

# Security Secrets (Generate secure random strings in production)
JWT_SECRET=your_super_secret_jwt_key_minimum_256_bits_for_production
ADMIN_SECRET_CODE=CIVICEYE-ADMIN-2026-SECURE

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-civiceye-app.vercel.app

# File Storage Directory
UPLOAD_DIR=uploads
